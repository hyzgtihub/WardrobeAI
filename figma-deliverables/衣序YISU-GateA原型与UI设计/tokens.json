{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "YISU Hi-Fi V3B",
  "version": "1.0.0",
  "description": "衣序 YISU Gate B2 高保真设计系统机器可读令牌。低保真资产不引用本文件。",
  "color": {
    "primitive": {
      "cream": { "$type": "color", "$value": "#FBF7EF", "description": "奶油白，全局画布底色。", "extensions": { "swiftUI": "Color.yisuCream" } },
      "paper": { "$type": "color", "$value": "#FFFCF7", "description": "暖白，卡片与浮层底色。", "extensions": { "swiftUI": "Color.yisuPaper" } },
      "paleKhaki": { "$type": "color", "$value": "#F2EBDC", "description": "极淡米卡其，用于柔和分区。", "extensions": { "swiftUI": "Color.yisuPaleKhaki" } },
      "grayBlue": { "$type": "color", "$value": "#AEBBD2", "description": "柔焦灰蓝。", "extensions": { "swiftUI": "Color.yisuGrayBlue" } },
      "grayBlueLight": { "$type": "color", "$value": "#EAF0F8", "description": "浅柔焦灰蓝。", "extensions": { "swiftUI": "Color.yisuGrayBlueLight" } },
      "lavender": { "$type": "color", "$value": "#B9AED8", "description": "薰衣草紫，品牌主色。", "extensions": { "swiftUI": "Color.yisuLavender" } },
      "lavenderDark": { "$type": "color", "$value": "#8879B5", "description": "深薰衣草紫，交互强调与高对比文本。", "extensions": { "swiftUI": "Color.yisuLavenderDark" } },
      "lavenderLight": { "$type": "color", "$value": "#EEE9FA", "description": "浅薰衣草紫，选中背景与柔和装饰。", "extensions": { "swiftUI": "Color.yisuLavenderLight" } },
      "blush": { "$type": "color", "$value": "#D8A7AE", "description": "复古肉粉。", "extensions": { "swiftUI": "Color.yisuBlush" } },
      "blushLight": { "$type": "color", "$value": "#F8E8EA", "description": "浅复古肉粉，衣物图片背景。", "extensions": { "swiftUI": "Color.yisuBlushLight" } },
      "sage": { "$type": "color", "$value": "#9DB8A6", "description": "鼠尾草绿。", "extensions": { "swiftUI": "Color.yisuSage" } },
      "sageLight": { "$type": "color", "$value": "#E7F0E9", "description": "浅鼠尾草绿，成功与标签背景。", "extensions": { "swiftUI": "Color.yisuSageLight" } },
      "ink": { "$type": "color", "$value": "#343445", "description": "暖调深墨色，主文本。", "extensions": { "swiftUI": "Color.yisuInk" } },
      "inkMuted": { "$type": "color", "$value": "#777383", "description": "次级文本。", "extensions": { "swiftUI": "Color.yisuInkMuted" } },
      "inkFaint": { "$type": "color", "$value": "#AAA4B2", "description": "占位符和禁用文本。", "extensions": { "swiftUI": "Color.yisuInkFaint" } },
      "line": { "$type": "color", "$value": "#E5DFE8", "description": "暖调分割线与描边。", "extensions": { "swiftUI": "Color.yisuLine" } },
      "white": { "$type": "color", "$value": "#FFFFFF", "description": "纯白，仅用于需要最高对比的前景。", "extensions": { "swiftUI": "Color.white" } },
      "danger": { "$type": "color", "$value": "#B85F68", "description": "错误和破坏性操作。", "extensions": { "swiftUI": "Color.yisuDanger" } },
      "dangerLight": { "$type": "color", "$value": "#FAE9EA", "description": "错误状态背景。", "extensions": { "swiftUI": "Color.yisuDangerLight" } },
      "scrim": { "$type": "color", "$value": "#34344566", "description": "弹层遮罩，40% 透明度。", "extensions": { "swiftUI": "Color.yisuScrim" } }
    },
    "semantic": {
      "background": { "$type": "color", "$value": "{color.primitive.cream}", "description": "应用全局背景。", "extensions": { "swiftUI": "Color.yisuBackground" } },
      "surface": { "$type": "color", "$value": "{color.primitive.paper}", "description": "卡片、表单和导航表面。", "extensions": { "swiftUI": "Color.yisuSurface" } },
      "surfaceSubtle": { "$type": "color", "$value": "{color.primitive.paleKhaki}", "description": "次级分区背景。", "extensions": { "swiftUI": "Color.yisuSurfaceSubtle" } },
      "brand": { "$type": "color", "$value": "{color.primitive.lavender}", "description": "默认品牌色。", "extensions": { "swiftUI": "Color.yisuBrand" } },
      "brandEmphasis": { "$type": "color", "$value": "{color.primitive.lavenderDark}", "description": "按钮文字、焦点和按下态。", "extensions": { "swiftUI": "Color.yisuBrandEmphasis" } },
      "brandSubtle": { "$type": "color", "$value": "{color.primitive.lavenderLight}", "description": "品牌浅底和选中态。", "extensions": { "swiftUI": "Color.yisuBrandSubtle" } },
      "accentBlue": { "$type": "color", "$value": "{color.primitive.grayBlueLight}", "description": "衣物卡片柔焦蓝背景。", "extensions": { "swiftUI": "Color.yisuAccentBlue" } },
      "accentBlush": { "$type": "color", "$value": "{color.primitive.blushLight}", "description": "衣物卡片复古肉粉背景。", "extensions": { "swiftUI": "Color.yisuAccentBlush" } },
      "accentSage": { "$type": "color", "$value": "{color.primitive.sageLight}", "description": "衣物卡片鼠尾草绿背景。", "extensions": { "swiftUI": "Color.yisuAccentSage" } },
      "textPrimary": { "$type": "color", "$value": "{color.primitive.ink}", "description": "主文本。", "extensions": { "swiftUI": "Color.yisuTextPrimary" } },
      "textSecondary": { "$type": "color", "$value": "{color.primitive.inkMuted}", "description": "辅助信息。", "extensions": { "swiftUI": "Color.yisuTextSecondary" } },
      "textPlaceholder": { "$type": "color", "$value": "{color.primitive.inkFaint}", "description": "占位符与不可用文本。", "extensions": { "swiftUI": "Color.yisuTextPlaceholder" } },
      "textOnBrand": { "$type": "color", "$value": "{color.primitive.white}", "description": "品牌实色按钮上的文本。", "extensions": { "swiftUI": "Color.yisuTextOnBrand" } },
      "border": { "$type": "color", "$value": "{color.primitive.line}", "description": "默认描边和分割线。", "extensions": { "swiftUI": "Color.yisuBorder" } },
      "success": { "$type": "color", "$value": "{color.primitive.sage}", "description": "自动保存成功状态。", "extensions": { "swiftUI": "Color.yisuSuccess" } },
      "successSubtle": { "$type": "color", "$value": "{color.primitive.sageLight}", "description": "成功状态浅底。", "extensions": { "swiftUI": "Color.yisuSuccessSubtle" } },
      "danger": { "$type": "color", "$value": "{color.primitive.danger}", "description": "错误与删除。", "extensions": { "swiftUI": "Color.yisuDanger" } },
      "dangerSubtle": { "$type": "color", "$value": "{color.primitive.dangerLight}", "description": "错误状态浅底。", "extensions": { "swiftUI": "Color.yisuDangerSubtle" } },
      "overlay": { "$type": "color", "$value": "{color.primitive.scrim}", "description": "模态遮罩。", "extensions": { "swiftUI": "Color.yisuOverlay" } }
    }
  },
  "spacing": {
    "space0": { "$type": "dimension", "$value": 0, "description": "无间距。", "extensions": { "swiftUI": "YISUSpacing.zero" } },
    "space1": { "$type": "dimension", "$value": 4, "description": "最小微间距。", "extensions": { "swiftUI": "YISUSpacing.xs2" } },
    "space2": { "$type": "dimension", "$value": 8, "description": "紧凑元素间距。", "extensions": { "swiftUI": "YISUSpacing.xs" } },
    "space3": { "$type": "dimension", "$value": 12, "description": "标签和图标间距。", "extensions": { "swiftUI": "YISUSpacing.sm" } },
    "space4": { "$type": "dimension", "$value": 16, "description": "基础间距单位。", "extensions": { "swiftUI": "YISUSpacing.md" } },
    "space5": { "$type": "dimension", "$value": 20, "description": "页面水平内边距。", "extensions": { "swiftUI": "YISUSpacing.lg" } },
    "space6": { "$type": "dimension", "$value": 24, "description": "区块内间距。", "extensions": { "swiftUI": "YISUSpacing.xl" } },
    "space8": { "$type": "dimension", "$value": 32, "description": "区块间距。", "extensions": { "swiftUI": "YISUSpacing.xl2" } },
    "space10": { "$type": "dimension", "$value": 40, "description": "大区块间距。", "extensions": { "swiftUI": "YISUSpacing.xl3" } },
    "space12": { "$type": "dimension", "$value": 48, "description": "页面章节间距。", "extensions": { "swiftUI": "YISUSpacing.xl4" } },
    "space16": { "$type": "dimension", "$value": 64, "description": "超大留白。", "extensions": { "swiftUI": "YISUSpacing.xl5" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": 8, "description": "小型标签与提示。", "extensions": { "swiftUI": "YISURadius.sm" } },
    "md": { "$type": "dimension", "$value": 12, "description": "输入框内部元素。", "extensions": { "swiftUI": "YISURadius.md" } },
    "lg": { "$type": "dimension", "$value": 16, "description": "输入框与小卡片。", "extensions": { "swiftUI": "YISURadius.lg" } },
    "xl": { "$type": "dimension", "$value": 20, "description": "内容卡片。", "extensions": { "swiftUI": "YISURadius.xl" } },
    "xl2": { "$type": "dimension", "$value": 24, "description": "衣物图片与大卡片。", "extensions": { "swiftUI": "YISURadius.xl2" } },
    "xl3": { "$type": "dimension", "$value": 32, "description": "页面容器与底部导航。", "extensions": { "swiftUI": "YISURadius.xl3" } },
    "full": { "$type": "dimension", "$value": 999, "description": "胶囊与圆形控件。", "extensions": { "swiftUI": "YISURadius.full" } }
  },
  "size": {
    "tapTarget": { "$type": "dimension", "$value": 44, "description": "iOS 最小触控尺寸。", "extensions": { "swiftUI": "YISUSize.tapTarget" } },
    "control": { "$type": "dimension", "$value": 48, "description": "紧凑控件高度。", "extensions": { "swiftUI": "YISUSize.control" } },
    "input": { "$type": "dimension", "$value": 56, "description": "表单输入框高度。", "extensions": { "swiftUI": "YISUSize.input" } },
    "primaryButton": { "$type": "dimension", "$value": 60, "description": "主按钮高度。", "extensions": { "swiftUI": "YISUSize.primaryButton" } },
    "brandMark": { "$type": "dimension", "$value": 84, "description": "登录页品牌标记直径。", "extensions": { "swiftUI": "YISUSize.brandMark" } }
  },
  "typography": {
    "display": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 700, "fontSize": 40, "lineHeight": 48, "letterSpacing": -0.6 }, "description": "品牌展示标题。", "extensions": { "swiftUI": "YISUTypography.display" } },
    "largeTitle": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 700, "fontSize": 34, "lineHeight": 41, "letterSpacing": -0.4 }, "description": "页面大标题。", "extensions": { "swiftUI": "YISUTypography.largeTitle" } },
    "title1": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 700, "fontSize": 28, "lineHeight": 34, "letterSpacing": -0.2 }, "description": "内容主标题。", "extensions": { "swiftUI": "YISUTypography.title1" } },
    "title2": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 700, "fontSize": 22, "lineHeight": 28, "letterSpacing": 0 }, "description": "卡片标题。", "extensions": { "swiftUI": "YISUTypography.title2" } },
    "headline": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 600, "fontSize": 17, "lineHeight": 22, "letterSpacing": 0 }, "description": "按钮与强调正文。", "extensions": { "swiftUI": "YISUTypography.headline" } },
    "body": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 400, "fontSize": 17, "lineHeight": 24, "letterSpacing": 0 }, "description": "默认正文与表单值。", "extensions": { "swiftUI": "YISUTypography.body" } },
    "callout": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 400, "fontSize": 16, "lineHeight": 21, "letterSpacing": 0 }, "description": "辅助正文。", "extensions": { "swiftUI": "YISUTypography.callout" } },
    "subheadline": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 400, "fontSize": 15, "lineHeight": 20, "letterSpacing": 0 }, "description": "元数据与次级说明。", "extensions": { "swiftUI": "YISUTypography.subheadline" } },
    "footnote": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 400, "fontSize": 13, "lineHeight": 18, "letterSpacing": 0 }, "description": "表单帮助与状态说明。", "extensions": { "swiftUI": "YISUTypography.footnote" } },
    "caption": { "$type": "typography", "$value": { "fontFamily": "SF Pro Rounded", "fontWeight": 500, "fontSize": 12, "lineHeight": 16, "letterSpacing": 0.1 }, "description": "紧凑标签与导航说明。", "extensions": { "swiftUI": "YISUTypography.caption" } }
  },
  "shadow": {
    "subtle": { "$type": "shadow", "$value": { "color": "#3434450A", "offsetX": 0, "offsetY": 2, "blur": 8, "spread": 0 }, "description": "表单和浅层分隔。", "extensions": { "swiftUI": "YISUShadow.subtle" } },
    "card": { "$type": "shadow", "$value": { "color": "#34344512", "offsetX": 0, "offsetY": 8, "blur": 24, "spread": 0 }, "description": "衣物卡片和内容卡片。", "extensions": { "swiftUI": "YISUShadow.card" } },
    "floating": { "$type": "shadow", "$value": { "color": "#3434451F", "offsetX": 0, "offsetY": 12, "blur": 32, "spread": 0 }, "description": "浮动按钮、菜单和底部导航。", "extensions": { "swiftUI": "YISUShadow.floating" } }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": 0.15, "description": "按压和图标切换。", "extensions": { "swiftUI": "YISUMotion.fast" } },
      "standard": { "$type": "duration", "$value": 0.25, "description": "标准控件状态切换。", "extensions": { "swiftUI": "YISUMotion.standard" } },
      "slow": { "$type": "duration", "$value": 0.4, "description": "页面级柔和过渡；不代表品牌动效。", "extensions": { "swiftUI": "YISUMotion.slow" } }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1], "description": "默认进入与状态切换曲线。", "extensions": { "swiftUI": "YISUMotion.standardCurve" } },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1], "description": "退出与收起曲线。", "extensions": { "swiftUI": "YISUMotion.exitCurve" } }
    }
  }
}
